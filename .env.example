# ==========================================

# MONGODB

# ==========================================

SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/sirh_db

# ==========================================

# EMAIL

# ==========================================

MAIL_USERNAME=[your-email@example.com](mailto:your-email@example.com)
MAIL_PASSWORD=your-gmail-app-password

# ==========================================

# JWT

# ==========================================

JWT_SECRET=replace-with-a-long-random-secret

JWT_ACCESS_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=604800000

# ==========================================

# CORS

# ==========================================

CORS_ALLOWED_ORIGINS=http://localhost:4200

# ==========================================

# FILE STORAGE

# ==========================================

FILE_UPLOAD_DIR=/app/uploads

# ==========================================

# OCR

# ==========================================

OCR_SPACE_API_KEY=helloworld
OCR_ENABLED=true

# ==========================================

# SERVER

# ==========================================

PORT=10000

# ==========================================

# DEFAULT USERS

# ==========================================

DEFAULT_ADMIN_EMAIL=[admin@sirh.com](mailto:admin@sirh.com)
DEFAULT_ADMIN_PASSWORD=change-me

DEFAULT_RH_EMAIL=[rh@sirh.com](mailto:rh@sirh.com)
DEFAULT_RH_PASSWORD=change-me

# ==========================================

# SPRING SECURITY

# ==========================================

SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=change-me
SPRING_SECURITY_USER_ROLES=ADMIN
